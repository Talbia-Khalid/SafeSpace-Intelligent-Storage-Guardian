
# Python
venv/
__pycache__/
*.pyc
*.pyo

# Compiled C files
*.o
*.out
backend/safespace

# Databases
*.db
*.sqlite
*.sqlite3

# Logs and reports
logs/*
reports/*

# Keep folders in Git
!logs/.gitkeep
!reports/.gitkeep

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.bak

# Vim temporary files
*.swp
*.swo

# Root compiled executable
/safespace

# Activity Monitor test files
/tests/activity_test.txt
/tests/gui_activity_test.txt
/tests/guardian_test/

# Runtime recovery vault data
/vault/*
!/vault/.gitkeep
